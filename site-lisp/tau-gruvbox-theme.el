;;; tau-gruvbox-theme.el --- Warm, muted dark theme -*- lexical-binding: t; -*-

;; Version: 0.1.0
;; Package-Requires: ((emacs "29.1"))
;; Keywords: faces, theme
;; URL: https://github.com/Tao-Boy/emacs.d

;;; Commentary:

;; A small, standalone theme inspired by the Gruvbox palette:
;; https://github.com/morhetz/gruvbox
;; Warm charcoal, cream text and restrained retro accents.  No dependencies.

;;; Code:

(deftheme tau-gruvbox
  "Warm charcoal and cream, inspired by Gruvbox."
  :background-mode 'dark
  :kind 'color-scheme)

(let ((bg "#282828")
      (bg-soft "#32302f")
      (bg1 "#3c3836")
      (bg2 "#504945")
      (fg "#ebdbb2")
      (fg-dim "#bdae93")
      (gray "#928374")
      (red "#fb4934")
      (green "#b8bb26")
      (yellow "#fabd2f")
      (blue "#83a598")
      (purple "#d3869b")
      (aqua "#8ec07c")
      (orange "#fe8019"))
  (custom-theme-set-faces
   'tau-gruvbox
   ;; Canvas and chrome.
   `(default ((t (:background ,bg :foreground ,fg))))
   `(cursor ((t (:background ,yellow))))
   `(fringe ((t (:background ,bg :foreground ,gray))))
   `(region ((t (:background ,bg2 :extend t))))
   `(secondary-selection ((t (:background ,bg1 :extend t))))
   `(hl-line ((t (:background ,bg-soft :extend t))))
   `(highlight ((t (:background ,bg1 :foreground ,fg))))
   `(shadow ((t (:foreground ,gray))))
   `(minibuffer-prompt ((t (:foreground ,blue :weight bold))))
   `(vertical-border ((t (:foreground ,bg2))))
   `(window-divider ((t (:foreground ,bg1))))
   '(window-divider-first-pixel ((t (:inherit window-divider))))
   '(window-divider-last-pixel ((t (:inherit window-divider))))
   `(mode-line ((t (:background ,bg1 :foreground ,fg :box nil))))
   `(mode-line-inactive ((t (:background ,bg-soft :foreground ,gray :box nil))))
   `(mode-line-buffer-id ((t (:foreground ,yellow :weight bold))))
   `(header-line ((t (:background ,bg-soft :foreground ,fg-dim :box nil))))
   `(tab-bar ((t (:background ,bg-soft :foreground ,fg-dim))))
   `(tab-bar-tab ((t (:background ,bg1 :foreground ,yellow :box nil))))
   `(tab-bar-tab-inactive ((t (:background ,bg-soft :foreground ,gray :box nil))))
   `(line-number ((t (:background ,bg :foreground ,gray))))
   `(line-number-current-line ((t (:background ,bg-soft :foreground ,yellow))))
   `(fill-column-indicator ((t (:foreground ,bg1))))
   `(trailing-whitespace ((t (:background "#60332f"))))
   `(whitespace-space ((t (:foreground ,bg2))))
   `(whitespace-tab ((t (:foreground ,bg2))))
   `(link ((t (:foreground ,blue :underline t))))
   `(link-visited ((t (:foreground ,purple :underline t))))
   `(button ((t (:inherit link))))
   `(success ((t (:foreground ,green :weight bold))))
   `(warning ((t (:foreground ,yellow :weight bold))))
   `(error ((t (:foreground ,red :weight bold))))
   ;; Search and matching delimiters.
   `(isearch ((t (:background ,yellow :foreground ,bg :weight bold))))
   `(isearch-fail ((t (:background "#60332f" :foreground ,fg))))
   `(lazy-highlight ((t (:background ,bg2 :foreground ,yellow))))
   `(match ((t (:background ,bg1 :foreground ,orange :weight bold))))
   `(show-paren-match ((t (:background ,bg2 :foreground ,yellow :weight bold))))
   `(show-paren-mismatch ((t (:background ,red :foreground ,bg :weight bold))))
   ;; Syntax, including tree-sitter's semantic faces.
   `(font-lock-comment-face ((t (:foreground ,gray :slant italic))))
   '(font-lock-comment-delimiter-face ((t (:inherit font-lock-comment-face))))
   `(font-lock-doc-face ((t (:foreground ,fg-dim :slant italic))))
   `(font-lock-string-face ((t (:foreground ,green))))
   `(font-lock-keyword-face ((t (:foreground ,red :weight bold))))
   `(font-lock-builtin-face ((t (:foreground ,orange))))
   `(font-lock-function-name-face ((t (:foreground ,yellow))))
   '(font-lock-function-call-face ((t (:inherit font-lock-function-name-face))))
   `(font-lock-variable-name-face ((t (:foreground ,blue))))
   '(font-lock-variable-use-face ((t (:inherit font-lock-variable-name-face))))
   `(font-lock-constant-face ((t (:foreground ,purple))))
   `(font-lock-type-face ((t (:foreground ,aqua))))
   `(font-lock-preprocessor-face ((t (:foreground ,orange))))
   `(font-lock-warning-face ((t (:foreground ,red :weight bold))))
   `(font-lock-number-face ((t (:foreground ,purple))))
   `(font-lock-operator-face ((t (:foreground ,orange))))
   `(font-lock-property-name-face ((t (:foreground ,blue))))
   '(font-lock-property-use-face ((t (:inherit font-lock-property-name-face))))
   `(font-lock-punctuation-face ((t (:foreground ,fg-dim))))
   '(font-lock-bracket-face ((t (:inherit font-lock-punctuation-face))))
   '(font-lock-delimiter-face ((t (:inherit font-lock-punctuation-face))))
   `(escape-glyph ((t (:foreground ,orange))))
   ;; Org: keep prose calm and the heading hierarchy easy to scan.
   `(org-document-title ((t (:foreground ,yellow :weight bold :height 1.3))))
   `(org-document-info ((t (:foreground ,fg-dim))))
   `(org-level-1 ((t (:foreground ,yellow :weight bold))))
   `(org-level-2 ((t (:foreground ,aqua :weight bold))))
   `(org-level-3 ((t (:foreground ,blue :weight bold))))
   `(org-level-4 ((t (:foreground ,orange :weight bold))))
   `(org-level-5 ((t (:foreground ,purple))))
   `(org-level-6 ((t (:foreground ,green))))
   `(org-level-7 ((t (:foreground ,fg-dim))))
   `(org-level-8 ((t (:foreground ,gray))))
   `(org-todo ((t (:foreground ,red :weight bold))))
   `(org-done ((t (:foreground ,green :weight bold))))
   `(org-headline-done ((t (:foreground ,gray))))
   `(org-priority ((t (:foreground ,orange :weight bold))))
   `(org-tag ((t (:foreground ,fg-dim :weight normal))))
   `(org-date ((t (:foreground ,blue :underline t))))
   '(org-link ((t (:inherit link))))
   `(org-block ((t (:background ,bg-soft :extend t))))
   `(org-block-begin-line ((t (:background ,bg-soft :foreground ,gray :extend t))))
   '(org-block-end-line ((t (:inherit org-block-begin-line))))
   `(org-code ((t (:foreground ,aqua))))
   `(org-verbatim ((t (:foreground ,green))))
   `(org-table ((t (:foreground ,aqua))))
   `(org-formula ((t (:foreground ,yellow))))
   `(org-latex-and-related ((t (:foreground ,aqua))))
   `(org-meta-line ((t (:foreground ,gray))))
   '(org-special-keyword ((t (:inherit org-meta-line))))
   `(org-ellipsis ((t (:foreground ,orange :underline nil))))
   `(org-agenda-structure ((t (:foreground ,yellow :weight bold))))
   `(org-scheduled ((t (:foreground ,green))))
   '(org-scheduled-today ((t (:inherit org-scheduled))))
   `(org-warning ((t (:foreground ,red :weight bold))))
   ;; Completion, navigation and input method.
   `(completions-common-part ((t (:foreground ,aqua :weight bold))))
   `(completions-first-difference ((t (:foreground ,orange))))
   `(vertico-current ((t (:background ,bg1 :extend t :weight bold))))
   `(orderless-match-face-0 ((t (:foreground ,yellow :weight bold))))
   `(orderless-match-face-1 ((t (:foreground ,aqua :weight bold))))
   `(orderless-match-face-2 ((t (:foreground ,purple :weight bold))))
   `(orderless-match-face-3 ((t (:foreground ,orange :weight bold))))
   `(consult-preview-line ((t (:background ,bg1 :extend t))))
   `(consult-highlight-match ((t (:foreground ,yellow :weight bold))))
   `(which-key-key-face ((t (:foreground ,yellow))))
   `(which-key-group-description-face ((t (:foreground ,aqua))))
   `(rimel-preedit-face ((t (:foreground ,aqua :underline t))))
   `(rimel-highlight-face ((t (:foreground ,yellow :weight bold))))
   `(rimel-candidate-label-face ((t (:foreground ,orange))))
   `(rimel-page-indicator-face ((t (:foreground ,gray))))
   `(dired-directory ((t (:foreground ,blue :weight bold))))
   `(dired-symlink ((t (:foreground ,aqua))))
   `(dired-marked ((t (:foreground ,yellow :weight bold))))
   `(dired-flagged ((t (:foreground ,red :weight bold))))
   ;; Diagnostics and version control.
   `(flymake-error ((t (:underline (:style wave :color ,red)))))
   `(flymake-warning ((t (:underline (:style wave :color ,yellow)))))
   `(flymake-note ((t (:underline (:style wave :color ,blue)))))
   `(eglot-highlight-symbol-face ((t (:background ,bg1 :weight bold))))
   `(diff-added ((t (:background "#343b2f" :foreground ,green :extend t))))
   `(diff-removed ((t (:background "#442c2e" :foreground ,red :extend t))))
   `(diff-changed ((t (:background "#40372c" :foreground ,yellow :extend t))))
   `(diff-refine-added ((t (:background "#45512b" :foreground ,green))))
   `(diff-refine-removed ((t (:background "#62312c" :foreground ,red))))
   `(diff-header ((t (:background ,bg1 :foreground ,fg-dim))))
   `(diff-file-header ((t (:background ,bg2 :foreground ,yellow :weight bold))))
   ;; Match the conventional Gruvbox terminal palette.
   `(ansi-color-black ((t (:background ,bg :foreground ,bg))))
   `(ansi-color-red ((t (:background "#cc241d" :foreground "#cc241d"))))
   `(ansi-color-green ((t (:background "#98971a" :foreground "#98971a"))))
   `(ansi-color-yellow ((t (:background "#d79921" :foreground "#d79921"))))
   `(ansi-color-blue ((t (:background "#458588" :foreground "#458588"))))
   `(ansi-color-magenta ((t (:background "#b16286" :foreground "#b16286"))))
   `(ansi-color-cyan ((t (:background "#689d6a" :foreground "#689d6a"))))
   `(ansi-color-white ((t (:background ,fg-dim :foreground ,fg-dim))))
   `(ansi-color-bright-black ((t (:background ,gray :foreground ,gray))))
   `(ansi-color-bright-red ((t (:background ,red :foreground ,red))))
   `(ansi-color-bright-green ((t (:background ,green :foreground ,green))))
   `(ansi-color-bright-yellow ((t (:background ,yellow :foreground ,yellow))))
   `(ansi-color-bright-blue ((t (:background ,blue :foreground ,blue))))
   `(ansi-color-bright-magenta ((t (:background ,purple :foreground ,purple))))
   `(ansi-color-bright-cyan ((t (:background ,aqua :foreground ,aqua))))
   `(ansi-color-bright-white ((t (:background ,fg :foreground ,fg))))))

(provide-theme 'tau-gruvbox)
;;; tau-gruvbox-theme.el ends here
