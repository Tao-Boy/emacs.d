;;; config-tests.el --- Loading boundaries and preserved workflows -*- lexical-binding: t; -*-

(ert-deftest tau-test-startup-is-offline-and-lazy ()
  (dolist (feature '(org org-id grep dired vertico orderless marginalia aas tempel corfu))
    (should-not (memq feature tau-check-eager-features)))
  (should (= gc-cons-threshold (* 16 1024 1024)))
  (should (= gc-cons-percentage 0.1))
  (should file-name-handler-alist)
  (should-not package-enable-at-startup)
  (should package-quickstart)
  (should (lookup-key global-map (kbd "C-c n n")))
  (dolist (function '(tau-org-files tau-org-current-node tau-org-node-index tau-org-read-node))
    (should-not (cdr (assq function tau-check-initial-commands))))
  (should (cdr (assq 'tau-org-new-note tau-check-initial-commands)))
  (should (eq (lookup-key global-map (kbd "C-c c")) 'org-capture)))

(ert-deftest tau-test-gc-restored-on-init-error ()
  (let ((tau-modules '(tau-nonexistent-module)))
    (load (expand-file-name "early-init.el" tau-check-root) nil t)
    (should-error (load (expand-file-name "init.el" tau-check-root) nil t)
                  :type 'file-missing)
    (should (= gc-cons-threshold (* 16 1024 1024)))
    (should (= gc-cons-percentage 0.1))))

(ert-deftest tau-test-package-cache-is-local ()
  (tau-packages-refresh)
  (should (file-readable-p package-quickstart-file))
  (should (file-readable-p (concat package-quickstart-file "c"))))

(ert-deftest tau-test-state-migration-preserves-existing-files ()
  (let ((legacy (locate-user-emacs-file "legacy-state"))
        (target (tau-state-file "migrated-state")))
    (write-region "original" nil legacy)
    (tau-state-migrate-file "legacy-state" target)
    (should (file-exists-p legacy))
    (with-temp-buffer
      (insert-file-contents target)
      (should (equal (buffer-string) "original")))
    (write-region "new state" nil target)
    (tau-state-migrate-file "legacy-state" target)
    (with-temp-buffer
      (insert-file-contents target)
      (should (equal (buffer-string) "new state")))))

(ert-deftest tau-test-completion-first-command ()
  ;; Initialize once, using the same hook as the interactive command loop.
  (run-hooks 'pre-command-hook)
  (should tau-completion-ready)
  (should-not (memq #'tau-completion-enable pre-command-hook))
  (dolist (function '(completing-read read-file-name read-buffer))
    (should-not (advice-member-p #'tau-completion-enable function)))
  (if (locate-library "vertico")
      (progn
        (should vertico-mode)
        (should-not (bound-and-true-p icomplete-mode)))
    (should (bound-and-true-p fido-vertical-mode)))
  (when (locate-library "orderless")
    (should (equal (orderless-filter "org init" '("init-org" "init-ui" "org-mode"))
                   '("init-org"))))
  (when (locate-library "marginalia") (should marginalia-mode))
  (tau-completion-enable)
  (should savehist-mode))

(ert-deftest tau-test-modal-and-theme ()
  (if (locate-library "evil")
      (progn (should evil-mode) (should-not evil-want-C-u-scroll))
    (should-not (bound-and-true-p evil-mode)))
  (should custom-enabled-themes))

(ert-deftest tau-test-programming-buffer ()
  (with-temp-buffer
    (emacs-lisp-mode)
    (insert "(defun example () (+ 1 2))")
    (font-lock-ensure)
    (should electric-pair-mode)
    (should (local-variable-p 'electric-pair-mode))
    (should display-line-numbers-mode)
    (when (locate-library "corfu") (should corfu-mode))
    (when (locate-library "rainbow-delimiters") (should rainbow-delimiters-mode))))

(ert-deftest tau-test-dired-first-visit ()
  (let ((buffer (dired-noselect tau-check-temp)))
    (unwind-protect
        (with-current-buffer buffer
          (should (derived-mode-p 'dired-mode))
          (should dired-omit-mode)
          (should (string-match-p dired-omit-files ".git")))
      (kill-buffer buffer))))

(ert-deftest tau-test-00-org-direct-entry-and-note-id ()
  ;; Exercise the autoload before opening an Org buffer explicitly.
  (tau-org-initialize-directories)
  (tau-org-new-note "中文 数学笔记" "methods")
  (should (derived-mode-p 'org-mode))
  (should org-indent-mode)
  (should visual-line-mode)
  (should (= fill-column 88))
  (should-not display-line-numbers-mode)
  (let ((node (tau-org-current-node)))
    (should (equal (plist-get node :title) "中文 数学笔记"))
    (should (string-match-p "^[[:xdigit:]]\\{8\\}-" (plist-get node :id)))
    (when (executable-find "rg")
      (let ((nodes (tau-org-node-index)))
        (should (= (length nodes) 1))
        (should (equal (plist-get (car nodes) :id) (plist-get node :id))))))
  (should (= (length (tau-org-files)) 4))
  ;; Exercise the pure Emacs traversal too, even when fd is installed.
  (cl-letf (((symbol-function 'tau-org--fd-program) (lambda () nil)))
    (should (= (length (tau-org-files)) 4)))
  (tau-org-refresh-id-db)
  ;; Initialization must not overwrite an existing principal file.
  (write-region "keep me" nil tau-org-index-file)
  (tau-org-initialize-directories)
  (with-temp-buffer
    (insert-file-contents tau-org-index-file)
    (should (equal (buffer-string) "keep me"))))

(ert-deftest tau-test-org-capture-agenda ()
  (require 'org-capture)
  (require 'org-agenda)
  (tau-org-initialize-directories)
  (org-capture nil "t")
  (insert "regression task")
  (org-capture-finalize)
  (org-todo-list)
  (with-current-buffer org-agenda-buffer-name
    (should (string-match-p "regression task" (buffer-string))))
  (kill-buffer org-agenda-buffer-name))

(ert-deftest tau-test-org-snippet-expansion ()
  (skip-unless (and (locate-library "aas") (locate-library "tempel")))
  (with-temp-buffer
    (org-mode)
    (should aas-mode)
    (insert "mk")
    (funcall (lookup-key (gethash 'org-mode aas-keymaps) (kbd "m k")))
    (insert "x")
    (tempel-done t)
    (should (equal (buffer-string) "\\(x\\)"))))

(ert-deftest tau-test-latex-editing ()
  (with-temp-buffer
    (tau-latex-mode)
    (insert "\\documentclass{article}\n\\begin{document}\nHello\n\\end{document}\n")
    (font-lock-ensure)
    (should (derived-mode-p 'latex-mode))
    (when (locate-library "tex-site")
      (should (fboundp 'TeX-command-master)))))

(ert-deftest tau-test-search-quotes-leading-dash ()
  (require 'tau-org-search)
  (let ((tau-org-root "/tmp/notes with spaces/") captured)
    (cl-letf (((symbol-function 'tau-org--rg-program) (lambda () "rg"))
              ((symbol-function 'grep) (lambda (command) (setq captured command))))
      (tau-org-rg-search "--literal; $(whoami)" t))
    (should (string-match-p (regexp-quote "--fixed-strings") captured))
    (should (string-match-p
             (regexp-quote (concat "-- " (shell-quote-argument "--literal; $(whoami)")))
             captured))
    (cl-letf (((symbol-function 'tau-org--rg-program) (lambda () "rg"))
              ((symbol-function 'tau-org-current-node) (lambda () '(:id "lowercase-id")))
              ((symbol-function 'grep) (lambda (command) (setq captured command))))
      (tau-org-backlinks))
    (should (string-match-p (regexp-quote "--case-sensitive") captured))))

